#
# Makefile — spike V2: does the Basilisk II core compile for bare-metal AArch64?
#
# Compiles only; linking is not the point. The output is the list of what the
# core needs that we do not yet provide.
#
include ../../external/circle-stdlib/Config.mk

MACEMU  = ../../external/macemu/BasiliskII/src
CIRCLEH = ../../external/circle-stdlib/libs/circle

CORE_DEFINES = -DDIRECT_ADDRESSING -DFPU_UAE -DEXCEPTIONS_VIA_LONGJMP \
               -DAARCH=64 -D__circle__

CORE_INCLUDES = -I. \
                -I$(MACEMU)/include \
                -I$(MACEMU)/uae_cpu_2021 \
                -I$(MACEMU)/Unix \
                -I$(MACEMU)/CrossPlatform \
                $(CIRCLE_STDLIB_INCLUDES) \
                -isystem $(CIRCLE_STDLIB_INSTALL_DIR)/include \
                -isystem $(CIRCLEH)/include \
                -isystem $(CIRCLEH)/addon

# Every core file that exists in the tree. cpuemu*/cpustbl* are generated by
# gencpu during the build and are deliberately absent here.
PROBE_SRCS = $(wildcard $(MACEMU)/*.cpp) $(wildcard $(MACEMU)/uae_cpu_2021/*.cpp) \
             $(MACEMU)/uae_cpu_2021/fpu/fpu_uae.cpp \
             $(MACEMU)/CrossPlatform/video_blit.cpp

probe:
	@for src in $(PROBE_SRCS); do \
	    printf '\n=== %s\n' "$$(basename $$src)"; \
	    $(CXX) $(ARCH) -std=gnu++17 -fno-exceptions -fno-rtti -c \
	        $(CORE_DEFINES) $(CORE_INCLUDES) $(CFLAGS_FOR_TARGET) \
	        "$$src" -o /dev/null 2>&1 | grep -E "error:" | head -3; \
	done

.PHONY: probe
