+/*
+ *  jit_arm64.h - 68k to AArch64 translator for the uae_cpu_2021 core
+ *
+ *  Basilisk II (C) 1997-2008 Christian Bauer
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef JIT_ARM64_H
+#define JIT_ARM64_H
+
+#include <stddef.h>
+
+struct jit_stats_t {
+	unsigned long blocks;		// blocks translated
+	unsigned long guest_insns;	// 68k instructions in them
+	unsigned long host_insns;	// AArch64 instructions emitted for them, exits included
+	unsigned long links;		// exits turned into direct branches
+	unsigned long entries;		// times translated code was entered from the host
+	unsigned long interpreted;	// instructions left to the interpreter
+	unsigned long invalidations;	// flushes that had something to put aside
+	unsigned long revalidated;	// blocks found unchanged after a flush
+	unsigned long discarded;	// blocks whose source had changed
+	unsigned long hard_flushes;	// times everything had to be forgotten
+	unsigned long range_flushes;	// host writes into guest memory announced
+	unsigned long range_hits;	// of which touched a page some translation came from
+};
+extern jit_stats_t jit_stats;
+
+// Supplied by the host: see jit_arm64.cpp
+extern void *jit_arm64_host_alloc_code(size_t size);	// memory that can be written and run
+extern void jit_arm64_host_poll(void);					// between two runs of translated code
+
+extern bool jit_arm64_init(void);
+extern void jit_arm64_flush(void);		// forget every translation
+extern void jit_arm64_invalidate_all(void);	// the guest flushed its instruction cache
+extern void jit_arm64_invalidate_range(uae_u32 addr, uae_u32 len);	// the host wrote into guest memory
+extern void m68k_jit_execute(void);		// m68k_execute(), with translated blocks
+
+#endif
