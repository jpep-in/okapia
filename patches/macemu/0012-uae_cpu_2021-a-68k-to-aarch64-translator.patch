+/*
+ *  jit_arm64.cpp - 68k to AArch64 translator for the uae_cpu_2021 core
+ *
+ *  Basilisk II (C) 1997-2008 Christian Bauer
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ *
+ *  This program is distributed in the hope that it will be useful,
+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ *
+ *  Design, in four rules:
+ *
+ *  1. The sixteen 68k registers live in AArch64 registers for as long as
+ *     translated code runs (D0-D7 in w19-w26, A0-A7 in w8-w15). They are
+ *     loaded once on the way in and stored once on the way out, never around
+ *     a block. A pinned register is only ever written as a W register, so
+ *     its upper half is zero and it can index guest memory directly.
+ *  2. The condition codes are the host's NZCV. The translator remembers at
+ *     compile time whether C holds the 68k carry or its complement (AArch64
+ *     subtracts with an inverted borrow) and picks the branch condition
+ *     accordingly; the stored form, at every exit, is the 68k one. X is kept
+ *     apart in w17.
+ *  3. Anything the translator does not know ends the block: the interpreter
+ *     runs that one instruction, from the same register file, and translation
+ *     resumes after it. The interpreter is the reference and the fallback.
+ *  4. A branch back to the head of its own block is a loop inside the block.
+ *     An exit to a known guest PC is patched into a direct branch once that
+ *     PC has a translation; a return looks its target up in a small table.
+ *     Nothing sits between two blocks. Every backward transfer spends one
+ *     unit of a budget kept in w16, so that the host gets control back.
+ */
+
+#include "sysdeps.h"
+#include "cpu_emulation.h"
+#include "main.h"
+#include "emul_op.h"
+#include "m68k.h"
+#include "memory.h"
+#include "readcpu.h"
+#include "newcpu.h"
+#include "jit_arm64.h"
+
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <vector>
+#ifndef JIT_ARM64_OWN_MEMORY
+#include <sys/mman.h>
+#endif
+#ifdef __APPLE__
+#include <pthread.h>
+#include <libkern/OSCacheControl.h>
+#endif
+
+extern int quit_program;
+
+/*
+ *  Code buffer and emitter
+ */
+
+static uae_u32 *code_base, *code_ptr, *code_end;
+static const size_t CODE_SIZE = 16 * 1024 * 1024;
+
+static inline void emit_long(uae_u32 w) { *code_ptr++ = w; }
+
+enum {
+	NATIVE_CC_EQ = 0, NATIVE_CC_NE, NATIVE_CC_CS, NATIVE_CC_CC, NATIVE_CC_MI, NATIVE_CC_PL,
+	NATIVE_CC_VS, NATIVE_CC_VC, NATIVE_CC_HI, NATIVE_CC_LS, NATIVE_CC_GE, NATIVE_CC_LT,
+	NATIVE_CC_GT, NATIVE_CC_LE, NATIVE_CC_AL
+};
+
+#include "codegen_arm64.h"
+
+// Fixed roles
+enum {
+	R_REGS = 27,		// &regs
+	R_MEM = 28,			// MEMBaseDiff: host address of guest address 0
+	R_X = 17,			// the 68k X flag, 0 or 1
+	R_BUDGET = 16,		// back-edges left before the host is given control
+	R_FLUSH = 7,		// scratch reserved for flag materialisation
+	R_SP = 31
+};
+static inline int DREG(int n) { return 19 + n; }
+static inline int AREG(int n) { return 8 + n; }
+
+static void write_begin(void)
+{
+#ifdef __APPLE__
+	pthread_jit_write_protect_np(0);
+#endif
+}
+
+static void write_end(uae_u32 *from)
+{
+#ifdef __APPLE__
+	pthread_jit_write_protect_np(1);
+	sys_icache_invalidate(from, (char *)code_ptr - (char *)from);
+#else
+	__builtin___clear_cache((char *)from, (char *)code_ptr);
+#endif
+}
+
+static void emit_mov64(int xd, uint64_t v)
+{
+	MOV_xi(xd, v & 0xffff);
+	if ((v >> 16) & 0xffff) MOVK_xish(xd, (v >> 16) & 0xffff, 16);
+	if ((v >> 32) & 0xffff) MOVK_xish(xd, (v >> 32) & 0xffff, 32);
+	if ((v >> 48) & 0xffff) MOVK_xish(xd, (v >> 48) & 0xffff, 48);
+}
+
+static void emit_mov32(int wd, uae_u32 v)
+{
+	if ((v & 0xffff0000) == 0) MOV_wi(wd, v);
+	else if ((v & 0xffff0000) == 0xffff0000) MOVN_wi(wd, ~v & 0xffff);
+	else if ((v & 0xffff) == 0) MOV_wish(wd, v >> 16, 16);
+	else { MOV_wi(wd, v & 0xffff); MOVK_wish(wd, v >> 16, 16); }
+}
+
+// wd = wn + imm, flags untouched
+static void emit_add_imm(int wd, int wn, uae_s32 imm)
+{
+	if (imm == 0) { if (wd != wn) MOV_ww(wd, wn); }
+	else if (imm > 0 && imm < 4096) ADD_wwi(wd, wn, imm);
+	else if (imm < 0 && imm > -4096) SUB_wwi(wd, wn, -imm);
+	else { emit_mov32(R_FLUSH, (uae_u32)imm); ADD_www(wd, wn, R_FLUSH); }
+}
+
+/*
+ *  State shared with the entry and exit thunks
+ */
+
+// x29 points here while translated code runs
+static const unsigned MAX_SLOTS = 1 << 20;
+static struct JitState {
+	uae_u32 nzcv;		// N Z C V in bits 31..28, C being the 68k carry
+	uae_u32 x;
+	uae_u32 budget;		// w16, across a call to the interpreter
+	uae_u32 epoch;		// raised by every flush
+	uae_u32 slot[MAX_SLOTS];	// per block: the epoch at which its source was last found unchanged
+} *jit_state_ptr;
+#define jit_state (*jit_state_ptr)		// allocated at start: four megabytes that have no place in .bss
+#define jit_epoch jit_state.epoch
+enum { R_STATE = 29 };
+
+static uint64_t jit_helper_interp(uae_u32 pc);
+// Opcodes the translator has declined at least once: when several follow each
+// other, the interpreter runs them in one call
+static uae_u8 opcode_declined[65536];
+static uae_u32 *helper_thunk, *exit_nostore;
+
+typedef uae_u32 (*enter_fn)(void *code);
+static enter_fn jit_enter;
+static uae_u32 *exit_thunk;
+
+// Why translated code went back to the host, counted on the way out
+enum { EXIT_BUDGET, EXIT_UNLINKED, EXIT_TABLE, EXIT_STALE, EXIT_ASK, EXIT_KINDS };
+static uint64_t exit_count[EXIT_KINDS];
+static uae_u32 *exit_via[EXIT_KINDS];
+
+static void build_thunks(void)
+{
+	write_begin();
+	uae_u32 *start = code_ptr;
+
+	// uae_u32 jit_enter(void *code)
+	jit_enter = (enter_fn)code_ptr;
+	STP_xxXpre(29, 30, R_SP, -96);
+	STP_xxXi(19, 20, R_SP, 16);
+	STP_xxXi(21, 22, R_SP, 32);
+	STP_xxXi(23, 24, R_SP, 48);
+	STP_xxXi(25, 26, R_SP, 64);
+	STP_xxXi(27, 28, R_SP, 80);
+	MOV_xx(2, 0);
+	emit_mov64(R_STATE, (uint64_t)&jit_state);
+	emit_mov64(R_REGS, (uint64_t)&regs);
+	emit_mov64(R_MEM, (uint64_t)MEMBaseDiff);
+	for (int i = 0; i < 8; i += 2) {
+		LDP_wwXi(DREG(i), DREG(i + 1), R_REGS, i * 4);
+		LDP_wwXi(AREG(i), AREG(i + 1), R_REGS, 32 + i * 4);
+	}
+	emit_mov64(1, (uint64_t)&jit_state);
+	LDR_wXi(0, 1, 0);
+	MSR_NZCV_x(0);
+	LDR_wXi(R_X, 1, 4);
+	MOV_wi(R_BUDGET, 4096);
+	BR_x(2);
+
+	// Reached by a branch, w0 = the next guest PC
+	exit_thunk = code_ptr;
+	for (int i = 0; i < 8; i += 2) {
+		STP_wwXi(DREG(i), DREG(i + 1), R_REGS, i * 4);
+		STP_wwXi(AREG(i), AREG(i + 1), R_REGS, 32 + i * 4);
+	}
+	emit_mov64(1, (uint64_t)&jit_state);
+	MRS_NZCV_x(2);
+	STR_wXi(2, 1, 0);
+	STR_wXi(R_X, 1, 4);
+	exit_nostore = code_ptr;		// the register file in memory is already the truth
+	LDP_xxXi(19, 20, R_SP, 16);
+	LDP_xxXi(21, 22, R_SP, 32);
+	LDP_xxXi(23, 24, R_SP, 48);
+	LDP_xxXi(25, 26, R_SP, 64);
+	LDP_xxXi(27, 28, R_SP, 80);
+	LDP_xxXpost(29, 30, R_SP, 96);
+	emit_long(0xd65f03c0);		// RET
+
+	for (int k = 0; k < EXIT_KINDS; k++) {
+		exit_via[k] = code_ptr;
+		emit_mov64(1, (uint64_t)&exit_count[k]);
+		LDR_xXi(2, 1, 0);
+		ADD_xxi(2, 2, 1);
+		STR_xXi(2, 1, 0);
+		B_i(exit_thunk - code_ptr);
+	}
+
+	// Called from a block with w0 = the PC of an instruction the translator does
+	// not know: the interpreter's handler runs it on the register file, and the
+	// block gets everything back, with w0 = the PC that follows. If the handler
+	// asked for anything else (an interrupt, a flush, the end), translated code is
+	// left for the host instead.
+	helper_thunk = code_ptr;
+	STR_xXpre(30, R_SP, -16);
+	for (int i = 0; i < 8; i += 2) {
+		STP_wwXi(DREG(i), DREG(i + 1), R_REGS, i * 4);
+		STP_wwXi(AREG(i), AREG(i + 1), R_REGS, 32 + i * 4);
+	}
+	emit_mov64(1, (uint64_t)&jit_state);
+	MRS_NZCV_x(2);
+	STR_wXi(2, 1, 0);
+	STR_wXi(R_X, 1, 4);
+	STR_wXi(R_BUDGET, 1, 8);
+	emit_mov64(2, (uint64_t)&jit_helper_interp);
+	BLR_x(2);
+	LDR_xXpost(30, R_SP, 16);
+	LSR_xxi(1, 0, 32);
+	CBNZ_wi(1, 0);
+	uae_u32 *leave = code_ptr - 1;
+	for (int i = 0; i < 8; i += 2) {
+		LDP_wwXi(DREG(i), DREG(i + 1), R_REGS, i * 4);
+		LDP_wwXi(AREG(i), AREG(i + 1), R_REGS, 32 + i * 4);
+	}
+	emit_mov64(1, (uint64_t)&jit_state);
+	LDR_wXi(2, 1, 0);
+	MSR_NZCV_x(2);
+	LDR_wXi(R_X, 1, 4);
+	LDR_wXi(R_BUDGET, 1, 8);
+	emit_long(0xd65f03c0);		// RET: a BR would defeat the return predictor at every call
+	*leave |= ((code_ptr - leave) & 0x7ffff) << 5;
+	MOV_ww(0, 0);
+	B_i(exit_nostore - code_ptr);
+
+	write_end(start);
+}
+
+/*
+ *  Translation context
+ */
+
+enum { SZ_B = 0, SZ_W = 1, SZ_L = 2 };
+static inline int size_bytes(int sz) { return 1 << sz; }
+static inline int size_shift(int sz) { return sz == SZ_B ? 24 : sz == SZ_W ? 16 : 0; }
+
+struct Stub {
+	uae_u32 *branch;	// conditional branch to patch
+	uae_u32 target;		// guest PC to leave with
+	bool c_inv;
+	bool bail;			// the instruction at `target` must be run by the interpreter
+};
+
+// An exit to a guest PC known at translation time, to be turned into a branch
+struct ExitSite {
+	uae_u32 *first;		// first instruction of the exit; may jump straight to a block that ignores incoming flags
+	uae_u32 *last;		// its final branch to the exit thunk; may jump to any block
+	uae_u32 target;
+	bool c_inv;			// at `first`, C is still the complement of the 68k carry
+};
+
+// Where a return or an indirect jump finds its target without leaving translated code
+struct LutEntry {
+	uae_u32 pc;
+	uae_u32 unused;
+	void *code;
+};
+static const unsigned LUT_BITS = 16;
+static LutEntry *jit_lut;
+// ROM and RAM addresses differ in their upper half: fold it in, or a routine in
+// ROM and one in RAM would keep taking the same entry from each other
+static inline unsigned lut_index(uae_u32 pc) { return ((pc ^ (pc >> 16)) >> 1) & ((1 << LUT_BITS) - 1); }
+
+struct Ctx {
+	uae_u32 start;		// guest PC of the block
+	uae_u32 pc;			// guest PC of the instruction being translated
+	uae_u32 next;		// cursor past the words already fetched
+	bool c_inv;			// host C is the complement of the 68k carry
+	int pend_reg;		// N and Z are those of this register's value, C = V = 0, not yet computed (-1: none)
+	int pend_size;
+	int x_cc;			// X is this host condition, not yet in w17 (-1: none)
+	bool head_dirty;	// something before the first flag setter reads flags or leaves the block
+	bool head_known;	// the first flag setter has been seen
+	size_t n_stubs;
+};
+
+static Ctx cx;
+static std::vector<Stub> stubs;
+static std::vector<ExitSite> sites;
+
+static inline uae_u16 fetch16(void)
+{
+	uae_u16 w = get_word(cx.next);
+	cx.next += 2;
+	return w;
+}
+
+static inline uae_u32 fetch32(void)
+{
+	uae_u32 l = get_long(cx.next);
+	cx.next += 4;
+	return l;
+}
+
+// Bring N Z C V up to date
+static void flush_x(void);
+
+static void flush_flags(void)
+{
+	if (cx.pend_reg >= 0) {
+		flush_x();		// X may still be a condition on the flags about to be replaced
+		if (cx.pend_size == SZ_L)
+			TST_ww(cx.pend_reg, cx.pend_reg);
+		else {
+			LSL_wwi(R_FLUSH, cx.pend_reg, size_shift(cx.pend_size));
+			TST_ww(R_FLUSH, R_FLUSH);
+		}
+		cx.pend_reg = -1;
+		cx.c_inv = false;
+	}
+}
+
+// Bring w17 up to date; must run before the host flags it depends on change
+static void flush_x(void)
+{
+	if (cx.x_cc >= 0) {
+		CSET_wc(R_X, cx.x_cc);
+		cx.x_cc = -1;
+	}
+}
+
+// A pinned register is about to change without the flags changing
+static void touch(int reg)
+{
+	if (cx.pend_reg == reg)
+		flush_flags();
+}
+
+static void flip_c(void)
+{
+	MRS_NZCV_x(R_FLUSH);
+	EOR_xxCflag(R_FLUSH, R_FLUSH);
+	MSR_NZCV_x(R_FLUSH);
+}
+
+// The instruction being translated replaces N Z C V: what was pending is dead
+static void flags_replaced(void)
+{
+	flush_x();
+	cx.pend_reg = -1;
+	if (!cx.head_known)
+		cx.head_known = true;
+}
+
+static void flags_needed(void)
+{
+	if (!cx.head_known)
+		cx.head_dirty = true;
+	flush_x();
+	flush_flags();
+}
+
+// Leave translated code for good, for a guest PC known at translation time
+static void emit_exit_hard(uae_u32 target, bool c_inv, int why)
+{
+	if (c_inv)
+		flip_c();
+	emit_mov32(0, target);
+	B_i(exit_via[why] - code_ptr);
+}
+
+// Leave the block for a guest PC known at translation time; the exit becomes
+// a branch to that PC's translation when there is one
+static void emit_exit(uae_u32 target, bool c_inv)
+{
+	const bool backward = target <= cx.pc;
+	uae_u32 *budget = NULL;
+	if (backward) {
+		SUB_wwi(R_BUDGET, R_BUDGET, 1);
+		CBZ_wi(R_BUDGET, 0);
+		budget = code_ptr - 1;
+	}
+	ExitSite site;
+	site.first = code_ptr;
+	site.target = target;
+	site.c_inv = c_inv;
+	B_i(1);
+	if (c_inv)
+		flip_c();
+	emit_mov32(0, target);
+	site.last = code_ptr;
+	B_i(exit_via[EXIT_UNLINKED] - code_ptr);
+	sites.push_back(site);
+	if (backward) {
+		*budget |= ((code_ptr - budget) & 0x7ffff) << 5;
+		emit_exit_hard(target, c_inv, EXIT_BUDGET);
+	}
+}
+
+// Leave with the guest PC in w0
+static void emit_lut_jump(void);
+
+static void emit_exit_dynamic(void)
+{
+	flags_needed();
+	if (cx.c_inv)
+		flip_c();
+	emit_lut_jump();
+}
+
+// w0 = a guest PC, the flags in 68k form: go to its translation if the table
+// has it, to the host otherwise
+static void emit_lut_jump(void)
+{
+	SUB_wwi(R_BUDGET, R_BUDGET, 1);
+	CBZ_wi(R_BUDGET, 0);
+	uae_u32 *miss1 = code_ptr - 1;
+	emit_mov64(2, (uint64_t)jit_lut);
+	emit_long((0b01001010010u << 21) | (0 << 16) | (16 << 10) | (0 << 5) | 1);	// eor w1, w0, w0, lsr #16
+	UBFX_wwii(1, 1, 1, LUT_BITS);
+	ADD_xxxLSLi(1, 2, 1, 4);
+	LDR_wXi(3, 1, 0);
+	EOR_www(3, 3, 0);
+	CBNZ_wi(3, 0);
+	uae_u32 *miss2 = code_ptr - 1;
+	LDR_xXi(2, 1, 8);
+	BR_x(2);
+	*miss2 |= ((code_ptr - miss2) & 0x7ffff) << 5;
+	B_i(exit_via[EXIT_TABLE] - code_ptr);
+	*miss1 |= ((code_ptr - miss1) & 0x7ffff) << 5;
+	B_i(exit_via[EXIT_BUDGET] - code_ptr);
+}
+
+static void end_block(uae_u32 target)
+{
+	flags_needed();
+	emit_exit(target, cx.c_inv);
+}
+
+/*
+ *  Effective addresses
+ */
+
+enum { EA_REG, EA_MEM, EA_IMM };
+
+struct EA {
+	int kind;
+	int reg;			// EA_REG: the pinned register; EA_MEM: register holding the guest address
+	uae_u32 imm;
+};
+
+// The index register of an extension word, scaled, added to `scratch`; w5 is used
+static void emit_add_index(int scratch, uae_u16 ext)
+{
+	const int xr = (ext & 0x8000) ? AREG((ext >> 12) & 7) : DREG((ext >> 12) & 7);
+	if (ext & 0x800) MOV_ww(5, xr); else SXTH_ww(5, xr);
+	ADD_wwwLSLi(scratch, scratch, 5, (ext >> 9) & 3);
+}
+
+// The 68020 full-format extension word: base and index can each be left out,
+// the base displacement is a word or a long, and the address can be fetched
+// from memory before or after the index is added. base_reg < 0: the base is
+// the constant base_const (PC-relative).
+static bool decode_full_ext(int base_reg, uae_u32 base_const, uae_u16 ext, int scratch)
+{
+	const int bdsz = (ext >> 4) & 3, iis = ext & 7;
+	const bool bs = ext & 0x80, is = ext & 0x40;
+	if (bdsz == 0 || (ext & 8) || (is && iis >= 4))
+		return false;
+	const uae_s32 bd = bdsz == 2 ? (uae_s32)(uae_s16)fetch16() : bdsz == 3 ? (uae_s32)fetch32() : 0;
+	uae_s32 od = 0;
+	if ((iis & 3) == 2) od = (uae_s16)fetch16();
+	else if ((iis & 3) == 3) od = (uae_s32)fetch32();
+
+	if (bs) emit_mov32(scratch, (uae_u32)bd);
+	else if (base_reg >= 0) emit_add_imm(scratch, base_reg, bd);
+	else emit_mov32(scratch, base_const + bd);
+	const bool post = !is && (iis & 4);
+	if (!is && !post)
+		emit_add_index(scratch, ext);
+	if (iis) {
+		LDR_wXx(scratch, scratch, R_MEM);
+		REV_ww(scratch, scratch);
+		if (post)
+			emit_add_index(scratch, ext);
+		emit_add_imm(scratch, scratch, od);
+	}
+	return true;
+}
+
+// Scratch registers: w0-w3 belong to the operation, w4-w5 to the source address,
+// w6 to the destination address
+static bool decode_ea(int mode, int reg, int sz, EA &ea, int scratch)
+{
+	switch (mode) {
+	case 0: ea.kind = EA_REG; ea.reg = DREG(reg); return true;
+	case 1: if (sz == SZ_B) return false; ea.kind = EA_REG; ea.reg = AREG(reg); return true;
+	case 2: ea.kind = EA_MEM; ea.reg = AREG(reg); return true;
+	case 3: {	// (An)+
+		int step = (reg == 7 && sz == SZ_B) ? 2 : size_bytes(sz);
+		touch(AREG(reg));
+		MOV_ww(scratch, AREG(reg));
+		ADD_wwi(AREG(reg), AREG(reg), step);
+		ea.kind = EA_MEM; ea.reg = scratch;
+		return true;
+	}
+	case 4: {	// -(An)
+		int step = (reg == 7 && sz == SZ_B) ? 2 : size_bytes(sz);
+		touch(AREG(reg));
+		SUB_wwi(AREG(reg), AREG(reg), step);
+		ea.kind = EA_MEM; ea.reg = AREG(reg);
+		return true;
+	}
+	case 5: {	// d16(An)
+		uae_s32 d = (uae_s16)fetch16();
+		emit_add_imm(scratch, AREG(reg), d);
+		ea.kind = EA_MEM; ea.reg = scratch;
+		return true;
+	}
+	case 6: {	// d8(An,Xn), brief format
+		const uae_u16 ext = fetch16();
+		if (ext & 0x100) {
+			if (!decode_full_ext(AREG(reg), 0, ext, scratch)) return false;
+			ea.kind = EA_MEM; ea.reg = scratch;
+			return true;
+		}
+		const int xr = (ext & 0x8000) ? AREG((ext >> 12) & 7) : DREG((ext >> 12) & 7);
+		if (ext & 0x800) MOV_ww(scratch, xr); else SXTH_ww(scratch, xr);
+		ADD_wwwLSLi(scratch, AREG(reg), scratch, (ext >> 9) & 3);
+		emit_add_imm(scratch, scratch, (uae_s8)(ext & 0xff));
+		ea.kind = EA_MEM; ea.reg = scratch;
+		return true;
+	}
+	case 7:
+		switch (reg) {
+		case 3: {	// d8(PC,Xn), brief format
+			const uae_u32 base = cx.next;
+			const uae_u16 ext = fetch16();
+			if (ext & 0x100) {
+				if (!decode_full_ext(-1, base, ext, scratch)) return false;
+				ea.kind = EA_MEM; ea.reg = scratch;
+				return true;
+			}
+			const int xr = (ext & 0x8000) ? AREG((ext >> 12) & 7) : DREG((ext >> 12) & 7);
+			if (ext & 0x800) MOV_ww(scratch, xr); else SXTH_ww(scratch, xr);
+			LSL_wwi(scratch, scratch, (ext >> 9) & 3);
+			emit_add_imm(scratch, scratch, (uae_s32)(base + (uae_s8)(ext & 0xff)));
+			ea.kind = EA_MEM; ea.reg = scratch;
+			return true;
+		}
+		case 0: emit_mov32(scratch, (uae_u32)(uae_s32)(uae_s16)fetch16()); ea.kind = EA_MEM; ea.reg = scratch; return true;
+		case 1: emit_mov32(scratch, fetch32()); ea.kind = EA_MEM; ea.reg = scratch; return true;
+		case 2: {	// d16(PC)
+			uae_u32 base = cx.next;
+			emit_mov32(scratch, base + (uae_s32)(uae_s16)fetch16());
+			ea.kind = EA_MEM; ea.reg = scratch;
+			return true;
+		}
+		case 4:
+			ea.kind = EA_IMM;
+			ea.imm = sz == SZ_L ? fetch32() : sz == SZ_W ? fetch16() : (fetch16() & 0xff);
+			return true;
+		}
+		return false;
+	}
+	return false;
+}
+
+// Value of an operand in a register. A pinned register is returned as it is:
+// only its low `sz` part is meaningful. A loaded value is zero-extended.
+static int load_ea(const EA &ea, int sz, int scratch)
+{
+	switch (ea.kind) {
+	case EA_REG:
+		return ea.reg;
+	case EA_IMM:
+		emit_mov32(scratch, ea.imm);
+		return scratch;
+	default:
+		if (sz == SZ_L) { LDR_wXx(scratch, ea.reg, R_MEM); REV_ww(scratch, scratch); }
+		else if (sz == SZ_W) { LDRH_wXx(scratch, ea.reg, R_MEM); REV16_ww(scratch, scratch); }
+		else LDRB_wXx(scratch, ea.reg, R_MEM);
+		return scratch;
+	}
+}
+
+static void store_ea(const EA &ea, int sz, int val, int scratch)
+{
+	if (ea.kind == EA_REG) {
+		touch(ea.reg);
+		if (sz == SZ_L) { if (ea.reg != val) MOV_ww(ea.reg, val); }
+		else BFI_wwii(ea.reg, val, 0, sz == SZ_W ? 16 : 8);
+		return;
+	}
+	if (sz == SZ_L) { REV_ww(scratch, val); STR_wXx(scratch, ea.reg, R_MEM); }
+	else if (sz == SZ_W) { REV16_ww(scratch, val); STRH_wXx(scratch, ea.reg, R_MEM); }
+	else STRB_wXx(val, ea.reg, R_MEM);
+}
+
+/*
+ *  Operations on a sized value
+ */
+
+static void emit_tst(int v, int sz)
+{
+	if (sz == SZ_L)
+		TST_ww(v, v);
+	else {
+		LSL_wwi(1, v, size_shift(sz));
+		TST_ww(1, 1);
+	}
+	cx.c_inv = false;
+}
+
+enum { OP_ADD, OP_SUB };
+
+// res = d op s on the low `sz` part of the registers, N Z C V from that part.
+// d and s may be pinned or scratch, w1 excepted; with `compare` nothing is kept.
+static void emit_arith(int op, int sz, int res, int d, int s, bool compare, bool set_x)
+{
+	flags_replaced();
+	if (sz == SZ_L) {
+		if (op == OP_ADD) ADDS_www(res, d, s);
+		else if (compare) CMP_ww(d, s);
+		else SUBS_www(res, d, s);
+	} else {
+		const int sh = size_shift(sz);
+		if (op == OP_ADD) {
+			LSL_wwi(1, s, sh);
+			ADDS_wwwLSLi(1, 1, d, sh);
+		} else {
+			LSL_wwi(1, d, sh);
+			SUBS_wwwLSLi(1, 1, s, sh);
+		}
+		if (!compare)
+			LSR_wwi(res, 1, sh);
+	}
+	cx.c_inv = (op == OP_SUB);
+	if (set_x)
+		cx.x_cc = (op == OP_SUB) ? NATIVE_CC_CC : NATIVE_CC_CS;
+}
+
+enum { B_ADD, B_SUB, B_CMP, B_AND, B_OR, B_EOR };
+
+// dst = dst op s, dst being a register or memory; s holds the source value
+static void emit_binop(int bop, int sz, const EA &dst, int s)
+{
+	const bool reg_long = dst.kind == EA_REG && sz == SZ_L;
+	const int d = load_ea(dst, sz, 2);
+	const int res = reg_long ? dst.reg : 3;
+	if (bop <= B_CMP) {
+		emit_arith(bop == B_ADD ? OP_ADD : OP_SUB, sz, res, d, s, bop == B_CMP, bop != B_CMP);
+		if (bop != B_CMP && !reg_long)
+			store_ea(dst, sz, 3, 1);
+		return;
+	}
+	flags_replaced();
+	if (bop == B_AND) AND_www(res, d, s);
+	else if (bop == B_OR) ORR_www(res, d, s);
+	else EOR_www(res, d, s);
+	if (dst.kind == EA_REG) {
+		if (!reg_long)
+			BFI_wwii(dst.reg, 3, 0, sz == SZ_W ? 16 : 8);
+		cx.pend_reg = dst.reg; cx.pend_size = sz;
+	} else {
+		store_ea(dst, sz, 3, 1);
+		emit_tst(3, sz);
+	}
+}
+
+// Host condition for a 68k condition code (2..15), given what C currently means
+static int host_cc(int cc)
+{
+	switch (cc) {
+	case 2: case 3:		// HI, LS: natural only with the inverted carry
+		if (!cx.c_inv) { flip_c(); cx.c_inv = true; }
+		return cc == 2 ? NATIVE_CC_HI : NATIVE_CC_LS;
+	case 4: return cx.c_inv ? NATIVE_CC_CS : NATIVE_CC_CC;
+	case 5: return cx.c_inv ? NATIVE_CC_CC : NATIVE_CC_CS;
+	case 6: return NATIVE_CC_NE;
+	case 7: return NATIVE_CC_EQ;
+	case 8: return NATIVE_CC_VC;
+	case 9: return NATIVE_CC_VS;
+	case 10: return NATIVE_CC_PL;
+	case 11: return NATIVE_CC_MI;
+	case 12: return NATIVE_CC_GE;
+	case 13: return NATIVE_CC_LT;
+	case 14: return NATIVE_CC_GT;
+	default: return NATIVE_CC_LE;
+	}
+}
+
+// One back-edge to the head of the block. The head was translated believing C
+// is the 68k carry.
+static void emit_loop_edge(uae_u32 *head)
+{
+	if (cx.c_inv && cx.head_dirty)
+		flip_c();
+	SUB_wwi(R_BUDGET, R_BUDGET, 1);
+	CBNZ_wi(R_BUDGET, head - code_ptr);
+	emit_exit_hard(cx.start, cx.c_inv && !cx.head_dirty, EXIT_BUDGET);
+}
+
+static inline void patch_here(uae_u32 *branch)
+{
+	*branch |= ((code_ptr - branch) & 0x7ffff) << 5;
+}
+
+// Push a long on the guest stack; v must not be w1
+static void emit_push(int v)
+{
+	touch(AREG(7));
+	SUB_wwi(AREG(7), AREG(7), 4);
+	REV_ww(1, v);
+	STR_wXx(1, AREG(7), R_MEM);
+}
+
+/*
+ *  One instruction. Returns 0 when it cannot be translated (nothing is kept),
+ *  1 when translation goes on, 2 when the block ends with it.
+ */
+
+static int translate_one(uae_u32 *head)
+{
+	const uae_u16 op = fetch16();
+	const int mode = (op >> 3) & 7, reg = op & 7, reg9 = (op >> 9) & 7;
+	EA src, dst;
+
+	if (op == 0x4e71)	// NOP
+		return 1;
+
+	switch (op >> 12) {
+	case 1: case 2: case 3: {	// MOVE, MOVEA
+		const int sz = (op >> 12) == 1 ? SZ_B : (op >> 12) == 3 ? SZ_W : SZ_L;
+		const int dmode = (op >> 6) & 7;
+		if (!decode_ea(mode, reg, sz, src, 4)) return 0;
+		int v = load_ea(src, sz, 0);
+		if (dmode == 1) {		// MOVEA: no flags, word sign-extended
+			if (sz == SZ_B) return 0;
+			touch(AREG(reg9));
+			if (sz == SZ_W) SXTH_ww(AREG(reg9), v);
+			else if (AREG(reg9) != v) MOV_ww(AREG(reg9), v);
+			return 1;
+		}
+		if (dmode == 7 && reg9 > 1) return 0;
+		if ((dmode == 3 || dmode == 4) && v == AREG(reg9)) {
+			// The destination moves the register being stored: store what it held
+			MOV_ww(0, v);
+			v = 0;
+		}
+		if (!decode_ea(dmode, reg9, sz, dst, 6)) return 0;
+		flags_replaced();
+		store_ea(dst, sz, v, 2);
+		if (dst.kind == EA_REG) { cx.pend_reg = dst.reg; cx.pend_size = sz; }
+		else if (v >= 8 && src.kind == EA_REG) { cx.pend_reg = v; cx.pend_size = sz; }
+		else emit_tst(v, sz);
+		return 1;
+	}
+
+	case 7:		// MOVEQ
+		if (op & 0x100) return 0;
+		flags_replaced();
+		emit_mov32(DREG(reg9), (uae_u32)(uae_s32)(uae_s8)(op & 0xff));
+		cx.pend_reg = DREG(reg9); cx.pend_size = SZ_L;
+		return 1;
+
+	case 5: {	// ADDQ, SUBQ, Scc, DBcc
+		const int sz = (op >> 6) & 3;
+		const int cc = (op >> 8) & 15;
+		if (sz == 3) {
+			if (mode == 1) {		// DBcc
+				const uae_u32 base = cx.next;
+				const uae_u32 target = base + (uae_s32)(uae_s16)fetch16();
+				if (cc == 0) return 1;		// DBT: never loops, never counts
+				flags_needed();
+				touch(DREG(reg));
+				uae_u32 *done = NULL;
+				if (cc != 1) {
+					CC_B_i(host_cc(cc), 0);
+					done = code_ptr - 1;
+				}
+				UXTH_ww(0, DREG(reg));
+				SUB_wwi(1, DREG(reg), 1);
+				BFI_wwii(DREG(reg), 1, 0, 16);
+				if (target == cx.start) {
+					CBZ_wi(0, 0);
+					uae_u32 *skip = code_ptr - 1;
+					emit_loop_edge(head);
+					patch_here(skip);
+				} else {
+					CBNZ_wi(0, 0);
+					stubs.push_back({ code_ptr - 1, target, cx.c_inv, false });
+				}
+				if (done)
+					patch_here(done);
+				return 1;
+			}
