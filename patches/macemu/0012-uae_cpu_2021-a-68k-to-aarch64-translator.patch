+		MRS_NZCV_x(1);
+		LDR_wXi(2, R_REGS, offsetof(struct regstruct, intmask));
+		MOV_wi(0, 0x2000);
+		ORR_wwwLSLi(0, 0, 2, 8);
+		ORR_wwwLSLi(0, 0, R_X, 4);
+		UBFX_wwii(2, 1, 31, 1); ORR_wwwLSLi(0, 0, 2, 3);	// N
+		UBFX_wwii(2, 1, 30, 1); ORR_wwwLSLi(0, 0, 2, 2);	// Z
+		UBFX_wwii(2, 1, 28, 1); ORR_wwwLSLi(0, 0, 2, 1);	// V
+		UBFX_wwii(2, 1, 29, 1); ORR_www(0, 0, 2);			// C
+		// The frame: status register, the trap's own address, format 0 and vector offset
+		touch(AREG(7));
+		SUB_wwi(AREG(7), AREG(7), 8);
+		REV16_ww(1, 0);
+		STRH_wXx(1, AREG(7), R_MEM);
+		emit_mov32(1, cx.pc);
+		REV_ww(1, 1);
+		ADD_wwi(2, AREG(7), 2);
+		STR_wXx(1, 2, R_MEM);
+		MOV_wi(1, 0x2800);		// $0028, already in memory order
+		ADD_wwi(2, AREG(7), 6);
+		STRH_wXx(1, 2, R_MEM);
+		LDR_wXi(2, R_REGS, offsetof(struct regstruct, vbr));
+		ADD_wwi(2, 2, 0x28);
+		LDR_wXx(0, 2, R_MEM);
+		REV_ww(0, 0);
+		emit_lut_jump();
+		return 2;
+	}
+
+	case 15:
+		if ((op & 0xfff8) == 0xf620) {	// MOVE16 (Ax)+,(Ay)+
+			const uae_u16 ext = fetch16();
+			const int ax = AREG(reg), ay = AREG((ext >> 12) & 7);
+			touch(ax); touch(ay);
+			CLEAR_LOW4_xx(4, ax);
+			CLEAR_LOW4_xx(6, ay);
+			ADD_xxx(4, 4, R_MEM);
+			ADD_xxx(6, 6, R_MEM);
+			LDP_xxXi(0, 1, 4, 0);
+			STP_xxXi(0, 1, 6, 0);
+			if (ax == ay) ADD_wwi(ax, ax, 16);		// the interpreter's answer for this odd case is checked by the fuzz
+			else { ADD_wwi(ax, ax, 16); ADD_wwi(ay, ay, 16); }
+			return 1;
+		}
+		return 0;
+	}
+	return 0;
+}
+
+/*
+ *  Blocks
+ */
+
+struct Block {
+	void *code;			// NULL: the instruction at this PC is the interpreter's
+	uae_u32 n_insns;
+	bool flags_dead;	// replaces N Z C V before reading them or leaving
+	uae_u32 epoch;		// current: runs; older: its head leaves at once, until it has been compared with its source
+	unsigned slot;		// where its head reads that epoch
+	uae_u32 *entry_inv;	// a second head for arrivals whose C is still inverted (blocks that ignore incoming flags)
+	uae_u32 src_len;
+	uae_u8 *src;		// the 68k bytes it was translated from
+	std::vector<ExitSite> sites;
+};
+
+// A flush raises the epoch and does nothing else to translated code. Every
+// block begins by comparing the epoch with the one stored for it, and leaves
+// for the host when they differ; the execution loop then compares the block's
+// source, byte for byte, with what memory holds now, and stores the new epoch
+// only if nothing changed. No instruction is rewritten for any of this, which
+// matters where rewriting code is expensive (a write-protected JIT region and
+// an instruction cache to flush).
+static unsigned next_slot;
+static unsigned flush_generation;			// raised when every translation is forgotten
+static std::vector<Block *> live;			// blocks of the current epoch that have code
+static std::vector<uae_u32> live_pc;		// and where their source is
+static const size_t CODE_BITS_SIZE = 1 << 23;
+static uae_u8 *code_bits;					// one bit per 64 bytes of guest memory some translation was made from
+
+static std::unordered_map<uae_u32, Block> blocks;
+static std::unordered_map<uae_u32, std::vector<ExitSite> > waiting;
+// Exits that jump to a block before putting C back in 68k form, because that
+// block ignores incoming flags; by target, in case its replacement does not
+static std::unordered_map<uae_u32, std::vector<ExitSite> > careless;
+
+static inline void patch_word(uae_u32 *where, uae_u32 word)
+{
+	*where = word;
+#ifdef __APPLE__
+	sys_icache_invalidate(where, 4);
+#else
+	__builtin___clear_cache((char *)where, (char *)(where + 1));
+#endif
+}
+
+static inline uae_u32 branch_to(const uae_u32 *from, const void *to)
+{
+	return (0b000101u << 26) | (((const uae_u32 *)to - from) & 0x03ffffff);
+}
+
+static void link_site(const ExitSite &site, const Block &to)
+{
+	if (to.flags_dead) {
+		// The block ignores incoming flags: skip the exit's own tidying of C. If C
+		// is inverted there, enter by the head that knows it.
+		patch_word(site.first, branch_to(site.first, site.c_inv ? (void *)to.entry_inv : to.code));
+		if (site.c_inv)
+			careless[site.target].push_back(site);
+	} else
+		patch_word(site.last, branch_to(site.last, to.code));
+	jit_stats.links++;
+}
+
+// The head of a block: leave if its source has not been compared since the last flush
+static uae_u32 *emit_epoch_check(unsigned slot)
+{
+	const uae_u32 off = offsetof(JitState, slot) + slot * 4;
+	LDR_wXi(1, R_STATE, offsetof(JitState, epoch));
+	if (off >> 12) {
+		emit_long((0b1001000101u << 22) | ((off >> 12) << 10) | (R_STATE << 5) | 2);	// add x2, x29, #hi, lsl #12
+		LDR_wXi(2, 2, off & 0xfff);
+	} else
+		LDR_wXi(2, R_STATE, off);
+	EOR_www(1, 1, 2);
+	CBNZ_wi(1, 0);
+	return code_ptr - 1;
+}
+
+static const unsigned MAX_BLOCK_INSNS = 64;
+
+jit_stats_t jit_stats;
+
+// Make a block of the current epoch reachable: the return table, its own exits,
+// the exits that were waiting for it. Call with the code buffer writable.
+static void make_live(uae_u32 pc, Block *b)
+{
+	LutEntry &e = jit_lut[lut_index(pc)];
+	e.pc = pc;
+	e.code = b->code;
+	live.push_back(b);
+	live_pc.push_back(pc);
+
+	for (size_t i = 0; i < b->sites.size(); i++) {
+		std::unordered_map<uae_u32, Block>::iterator t = blocks.find(b->sites[i].target);
+		if (t != blocks.end() && t->second.code)
+			link_site(b->sites[i], t->second);		// a block waiting to be compared leaves by itself
+		else
+			waiting[b->sites[i].target].push_back(b->sites[i]);
+	}
+	std::unordered_map<uae_u32, std::vector<ExitSite> >::iterator w = waiting.find(pc);
+	if (w != waiting.end()) {
+		for (size_t i = 0; i < w->second.size(); i++)
+			link_site(w->second[i], *b);
+		waiting.erase(w);
+	}
+}
+
+static Block *compile_block(uae_u32 pc);
+
+// A block of an older epoch was asked for: it comes back if its source has not
+// changed by one byte, and is translated again otherwise
+static Block *revalidate(uae_u32 pc, Block *b)
+{
+	if (memcmp(b->src, get_real_address(pc, 0, sz_word), b->src_len) == 0) {
+		b->epoch = jit_epoch;
+		if (b->code) {
+			jit_state.slot[b->slot] = jit_epoch;
+			live.push_back(b);
+			live_pc.push_back(pc);
+		}
+		jit_stats.revalidated++;
+		return b;
+	}
+
+	// The source changed. Branches into the old code remain; its slot never
+	// matches again, so whatever still arrives there leaves for the host.
+	uae_u32 * const old_head = (uae_u32 *)b->code;
+	uae_u32 * const old_inv = b->entry_inv;
+	const bool old_flags_dead = b->flags_dead;
+	free(b->src);
+	b->src = NULL;
+	jit_stats.discarded++;
+	const unsigned generation = flush_generation;
+	Block *n = compile_block(pc);
+	if (!old_head || generation != flush_generation)	// nothing branched there, or everything was just forgotten
+		return n;
+	write_begin();
+	if (old_flags_dead) {
+		if (n->flags_dead)
+			patch_word(old_inv, branch_to(old_inv, n->entry_inv));
+		else {
+			// Some exits reach the old code without having put C back in 68k form,
+			// because it ignored incoming flags; the new code does not. Those
+			// exits go back to their long way round.
+			std::unordered_map<uae_u32, std::vector<ExitSite> >::iterator c = careless.find(pc);
+			if (c != careless.end()) {
+				for (size_t i = 0; i < c->second.size(); i++) {
+					const ExitSite &site = c->second[i];
+					patch_word(site.first, (0b000101u << 26) | 1);
+					patch_word(site.last, branch_to(site.last, n->code));
+				}
+				careless.erase(c);
+			}
+			jit_stats.hard_flushes++;		// counts these events; nothing is forgotten
+		}
+	}
+	patch_word(old_head, branch_to(old_head, n->code));
+	write_end(code_ptr);
+	return n;
+}
+
+// The guest flushed its instruction cache: nothing translated may run again
+// before it has been compared with its source.
+//
+// The blocks that have run since the last flush are compared here and now: a
+// flush is nearly always followed by the same code, and comparing a few hundred
+// short sources costs less than letting each block leave and come back. Every
+// sixteenth flush skips that, so that a block which is no longer used stops
+// being compared.
+void jit_arm64_invalidate_all(void)
+{
+	if (!code_base)			// the translator is built in but not in use
+		return;
+	jit_epoch++;
+	jit_stats.invalidations++;
+	if (live.empty())
+		return;
+	size_t kept = 0;
+	if ((jit_stats.invalidations & 15) != 0)
+		for (size_t i = 0; i < live.size(); i++) {
+			Block *b = live[i];
+			if (memcmp(b->src, get_real_address(live_pc[i], 0, sz_word), b->src_len) != 0)
+				continue;
+			b->epoch = jit_epoch;
+			jit_state.slot[b->slot] = jit_epoch;
+			live[kept] = b;
+			live_pc[kept++] = live_pc[i];
+		}
+	live.resize(kept);
+	live_pc.resize(kept);
+}
+
+// The host wrote into guest memory
+void jit_arm64_invalidate_range(uae_u32 addr, uae_u32 len)
+{
+	if (len == 0 || !code_base)
+		return;
+	jit_stats.range_flushes++;
+	for (uae_u32 a = addr >> 6; a <= (addr + len - 1) >> 6; a++)
+		if (code_bits[a >> 3] & (1 << (a & 7))) {
+			jit_stats.range_hits++;
+			jit_arm64_invalidate_all();
+			return;
+		}
+}
+
+static Block *compile_block(uae_u32 pc)
+{
+	if ((size_t)(code_end - code_ptr) < 4096 || next_slot >= MAX_SLOTS)
+		jit_arm64_flush();
+
+	write_begin();
+	uae_u32 *start = code_ptr;
+	const unsigned slot = next_slot++;
+	uae_u32 *stale = emit_epoch_check(slot);
+	uae_u32 *head = code_ptr;
+	stubs.clear();
+	sites.clear();
+	cx = Ctx();
+	cx.start = cx.pc = cx.next = pc;
+	cx.pend_reg = -1;
+	cx.x_cc = -1;
+
+	unsigned n = 0;
+	bool ended = false;
+	while (n < MAX_BLOCK_INSNS) {
+		const Ctx saved = cx;
+		uae_u32 * const saved_ptr = code_ptr;
+		const size_t saved_stubs = stubs.size();
+		const size_t saved_sites = sites.size();
+		cx.pc = cx.next;
+		const int r = translate_one(head);
+		if (r == 0) {
+			// Not an instruction the translator knows: the interpreter's handler
+			// runs it, from inside the block, and the block ends there because
+			// only the handler knows where the instruction ends
+			cx = saved;
+			code_ptr = saved_ptr;
+			stubs.resize(saved_stubs);
+			sites.resize(saved_sites);
+			opcode_declined[get_word(cx.next)] = 1;
+			flags_needed();
+			if (cx.c_inv) { flip_c(); cx.c_inv = false; }
+			emit_mov32(0, cx.next);
+			BL_i(helper_thunk - code_ptr);
+			emit_lut_jump();
+			cx.next += 2;		// its opcode word belongs to the source that is compared
+			n++;
+			ended = true;
+			break;
+		}
+		n++;
+		if (r == 2) { ended = true; break; }
+	}
+
+	Block b;
+	b.code = NULL; b.n_insns = n; b.flags_dead = false;
+	b.epoch = jit_epoch;
+	b.slot = slot;
+	b.entry_inv = NULL;
+	b.src_len = n > 0 ? cx.next - pc : 2;
+	b.src = (uae_u8 *)malloc(b.src_len);
+	memcpy(b.src, get_real_address(pc, 0, sz_word), b.src_len);
+	for (uae_u32 a = pc >> 6; a <= (pc + b.src_len - 1) >> 6; a++)
+		code_bits[a >> 3] |= 1 << (a & 7);
+	if (n > 0) {
+		if (!ended)
+			end_block(cx.next);
+		for (size_t i = 0; i < stubs.size(); i++) {
+			const Stub &s = stubs[i];
+			*s.branch |= ((code_ptr - s.branch) & 0x7ffff) << 5;
+			if (s.bail) emit_exit_hard(s.target | 1, s.c_inv, EXIT_ASK);	// an odd PC: a request, not an address
+			else emit_exit(s.target, s.c_inv);
+		}
+		b.code = start;
+		b.flags_dead = cx.head_known && !cx.head_dirty;
+		patch_here(stale);
+		emit_exit_hard(pc, false, EXIT_STALE);
+		if (b.flags_dead) {
+			b.entry_inv = code_ptr;
+			stale = emit_epoch_check(slot);
+			B_i(head - code_ptr);
+			patch_here(stale);
+			emit_exit_hard(pc, true, EXIT_STALE);		// C goes back to the 68k form on the way out
+		}
+		jit_state.slot[slot] = jit_epoch;
+		jit_stats.blocks++;
+		jit_stats.guest_insns += n;
+		jit_stats.host_insns += code_ptr - start;
+	} else {
+		code_ptr = start;
+		sites.clear();
+	}
+
+	b.sites = sites;
+	Block *stored = &(blocks[pc] = b);
+	if (b.code)
+		make_live(pc, stored);
+	write_end(start);
+
+	return stored;
+}
+
+void jit_arm64_flush(void)
+{
+	for (std::unordered_map<uae_u32, Block>::iterator it = blocks.begin(); it != blocks.end(); ++it)
+		free(it->second.src);
+	blocks.clear();
+	waiting.clear();
+	careless.clear();
+	live.clear();
+	live_pc.clear();
+	memset(code_bits, 0, CODE_BITS_SIZE);
+	jit_epoch++;
+	flush_generation++;
+	next_slot = 0;
+	for (unsigned i = 0; i < (1u << LUT_BITS); i++) {
+		jit_lut[i].pc = 0xffffffff;		// odd: never a guest PC
+		jit_lut[i].code = NULL;
+	}
+	code_ptr = code_base;
+	build_thunks();
+}
+
+/*
+ *  What the host provides. A hosted build takes the two below; a port with
+ *  no mmap (a bare-metal kernel) defines JIT_ARM64_OWN_MEMORY and supplies its
+ *  own jit_arm64_host_alloc_code(). Likewise JIT_ARM64_OWN_POLL for
+ *  jit_arm64_host_poll(), called every time translated code comes back to
+ *  the execution loop: at least once every few thousand backward branches.
+ */
+
+#ifndef JIT_ARM64_OWN_MEMORY
+void *jit_arm64_host_alloc_code(size_t size)
+{
+	int flags = MAP_PRIVATE | MAP_ANON;
+#ifdef __APPLE__
+	flags |= MAP_JIT;
+#endif
+	void *p = mmap(NULL, size, PROT_READ | PROT_WRITE | PROT_EXEC, flags, -1, 0);
+	if (p == MAP_FAILED) {
+		perror("jit_arm64: mmap");
+		return NULL;
+	}
+	return p;
+}
+#endif
+
+#ifndef JIT_ARM64_OWN_POLL
+void jit_arm64_host_poll(void)
+{
+	cpu_check_ticks();
+}
+#endif
+
+// Everything is allocated once, here. Called again (the Macintosh restarts, or
+// another one starts in the same process) it forgets every translation and
+// builds its entry code anew, since guest memory may have moved.
+bool jit_arm64_init(void)
+{
+	if (code_base) {
+		jit_arm64_flush();
+		return true;
+	}
+	jit_state_ptr = (JitState *)calloc(1, sizeof(JitState));
+	jit_lut = (LutEntry *)calloc((size_t)1 << LUT_BITS, sizeof(LutEntry));
+	code_bits = (uae_u8 *)calloc(1, CODE_BITS_SIZE);
+	void *p = jit_state_ptr && jit_lut && code_bits ? jit_arm64_host_alloc_code(CODE_SIZE) : NULL;
+	if (!p) {
+		free(jit_state_ptr); free(jit_lut); free(code_bits);
+		jit_state_ptr = NULL; jit_lut = NULL; code_bits = NULL;
+		return false;
+	}
+	jit_state.epoch = 1;		// a slot that was never written holds 0 and matches nothing
+	code_base = code_ptr = (uae_u32 *)p;
+	code_end = code_base + CODE_SIZE / 4;
+	jit_arm64_flush();
+	return true;
+}
+
+/*
+ *  Condition codes between the interpreter's representation and ours
+ */
+
+static inline void flags_to_jit(void)
+{
+	jit_state.nzcv = (GET_NFLG() ? 0x80000000u : 0) | (GET_ZFLG() ? 0x40000000u : 0)
+	               | (GET_CFLG() ? 0x20000000u : 0) | (GET_VFLG() ? 0x10000000u : 0);
+	jit_state.x = GET_XFLG() ? 1 : 0;
+}
+
+static inline void flags_from_jit(void)
+{
+	const uae_u32 f = jit_state.nzcv;
+	SET_NFLG((f >> 31) & 1);
+	SET_ZFLG((f >> 30) & 1);
+	SET_CFLG((f >> 29) & 1);
+	SET_VFLG((f >> 28) & 1);
+	SET_XFLG(jit_state.x & 1);
+}
+
+/*
+ *  The execution loop: translated blocks where there are some, the
+ *  interpreter's own handler for everything else
+ */
+
+static unsigned long stats_every, stats_count;
+static unsigned long why_new, why_stale, why_evicted, why_other, helper_leaves;
+static uae_u32 *opcode_histogram;
+
+// The opcodes the interpreter was asked for most, to know what to translate next
+static void print_histogram(void)
+{
+	for (int rank = 0; rank < 30; rank++) {
+		unsigned best = 0;
+		for (unsigned i = 1; i < 65536; i++)
+			if (opcode_histogram[i] > opcode_histogram[best]) best = i;
+		if (!opcode_histogram[best]) break;
+		fprintf(stderr, "jit: interpreted %04x %u times\n", (unsigned)((best >> 8) | ((best & 0xff) << 8)), opcode_histogram[best]);
+		opcode_histogram[best] = 0;
+	}
+	memset(opcode_histogram, 0, 65536 * sizeof(uae_u32));
+}
+
+// One instruction by the interpreter, on behalf of translated code. Returns the
+// PC that follows, with a nonzero upper half when translated code must be left.
+static uint64_t jit_helper_interp(uae_u32 pc)
+{
+	const uae_u32 epoch = jit_epoch;
+	flags_from_jit();
+	m68k_setpc(pc);
+	for (;;) {
+		const uae_u32 opcode = GET_OPCODE;
+		if (opcode_histogram)
+			opcode_histogram[opcode]++;
+		(*cpufunctbl[opcode])(opcode);
+		jit_stats.interpreted++;
+		if (SPCFLAGS_TEST(SPCFLAG_ALL) || quit_program || jit_epoch != epoch) {
+			helper_leaves++;
+			flags_to_jit();
+			return m68k_getpc() | ((uint64_t)1 << 32);
+		}
+		// Go on while what follows is the interpreter's as well
+		if (!opcode_declined[get_word(m68k_getpc())])
+			break;
+	}
+	flags_to_jit();
+	return m68k_getpc();
+}
+
+void m68k_jit_execute(void)
+{
+	if (const char *e = getenv("B2_JIT_STATS"))
+		stats_every = strtoul(e, NULL, 0);		// a line every so many turns of the loop
+	if (getenv("B2_JIT_HISTOGRAM"))
+		opcode_histogram = (uae_u32 *)calloc(65536, sizeof(uae_u32));
+	// A test of one claim: a block said to ignore incoming N Z C V is entered
+	// with all four inverted, and must compute what the interpreter computes
+	const bool poison_dead = getenv("B2_JIT_POISON") != NULL;
+	// Another: an interrupt every so many returns to this loop, at a cadence
+	// that does not depend on the clock, so that a fault it causes repeats
+	const unsigned long irq_every = getenv("B2_JIT_IRQ") ? strtoul(getenv("B2_JIT_IRQ"), NULL, 0) : 0;
+	unsigned long irq_count = 0;
+
+	for (;;) {
+		if (quit_program > 0) {
+			if (quit_program == 1)
+				break;
+			quit_program = 0;
+			m68k_reset();
+		}
+
+		const uae_u32 pc = m68k_getpc();
+		std::unordered_map<uae_u32, Block>::iterator it = blocks.find(pc);
+		if (stats_every) {
+			// Why did translated code come back here?
+			if (it == blocks.end()) why_new++;
+			else if (it->second.epoch != jit_epoch) why_stale++;
+			else if (jit_lut[lut_index(pc)].pc != pc) why_evicted++;
+			else why_other++;
+		}
+		Block *b = it != blocks.end() ? &it->second : compile_block(pc);
+		if (b->epoch != jit_epoch)
+			b = revalidate(pc, b);
+		else if (b->code) {
+			// Whatever sent us here may look this PC up again: the entry is its own
+			LutEntry &e = jit_lut[lut_index(pc)];
+			e.pc = pc;
+			e.code = b->code;
+		}
+
+		if (b->code) {
+			flags_to_jit();
+			if (poison_dead && b->flags_dead)
+				jit_state.nzcv ^= 0xf0000000;
+			const uae_u32 next = jit_enter(b->code);
+			flags_from_jit();
+			m68k_setpc(next & ~1);
+			jit_stats.entries++;
+			if (next & 1) {
+				// Translated code met a case it leaves to the interpreter (a divide
+				// that traps or overflows): this one instruction is the interpreter's
+				const uae_u32 opcode = GET_OPCODE;
+				(*cpufunctbl[opcode])(opcode);
+				jit_stats.interpreted++;
+			}
+		} else {
+			const uae_u32 opcode = GET_OPCODE;
+			if (opcode_histogram)
+				opcode_histogram[opcode]++;		// GET_OPCODE is the table index: byte-swapped on this host
+			(*cpufunctbl[opcode])(opcode);
+			jit_stats.interpreted++;
+		}
+		jit_arm64_host_poll();
+		if (irq_every && ++irq_count >= irq_every) {
+			irq_count = 0;
+			SetInterruptFlag(INTFLAG_60HZ);
+			TriggerInterrupt();
+		}
+
+		if (SPCFLAGS_TEST(SPCFLAG_ALL_BUT_EXEC_RETURN))
+			m68k_do_specialties();		// what it asks for is in quit_program
+
+		if (stats_every && ++stats_count >= stats_every) {
+			stats_count = 0;
+			fprintf(stderr, "jit: pc=%08x blocks=%lu guest=%lu host=%lu links=%lu entries=%lu interp=%lu inval=%lu reval=%lu disc=%lu hard=%lu range=%lu hits=%lu\n",
+				m68k_getpc(), jit_stats.blocks, jit_stats.guest_insns, jit_stats.host_insns, jit_stats.links,
+				jit_stats.entries, jit_stats.interpreted, jit_stats.invalidations, jit_stats.revalidated, jit_stats.discarded,
+				jit_stats.hard_flushes, jit_stats.range_flushes, jit_stats.range_hits);
+			fprintf(stderr, "jit: back to the host for a PC that was new=%lu stale=%lu evicted=%lu other=%lu\n",
+				why_new, why_stale, why_evicted, why_other);
+			fprintf(stderr, "jit: left by budget=%llu unlinked=%llu table=%llu stale=%llu ask=%llu helper=%lu\n",
+				exit_count[EXIT_BUDGET], exit_count[EXIT_UNLINKED], exit_count[EXIT_TABLE], exit_count[EXIT_STALE],
+				exit_count[EXIT_ASK], helper_leaves);
+			if (opcode_histogram)
+				print_histogram();
+		}
+	}
+}
