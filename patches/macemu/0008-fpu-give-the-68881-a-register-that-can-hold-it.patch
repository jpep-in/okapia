+	   it copied wrd2 down from bit 31, integer bit included, which shifted
+	   every significand one place and made the round trip lossy in a way that
+	   looked like rounding.
+
+	   An unnormalised operand — integer bit clear with a non-zero exponent,
+	   which the 68881 can produce — has no binary128 spelling, so it is
+	   normalised first. That is exact here: there are 49 spare fraction bits
+	   to shift into.  */
 	fp_declare_init_shape(srp, extended);
-	srp.ieee.negative  = (wrd1 >> 31) & 1;
-	srp.ieee.exponent  = (wrd1 >> 16) & FP_EXTENDED_EXP_MAX;
-	srp.ieee.mantissa0 = (wrd2 >> 16) & 0xffff;
-	srp.ieee.mantissa1 = ((wrd2 & 0xffff) << 16) | ((wrd3 >> 16) & 0xffff);
-	srp.ieee.mantissa2 = (wrd3 & 0xffff) << 16;
