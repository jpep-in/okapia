 PRIVATE inline void FFPU make_nan(fpu_register & r, bool negative)
 {
-#if defined(USE_LONG_DOUBLE) || defined(USE_QUAD_DOUBLE)
+	/* Three layouts, not two. The x87 double-extended has an explicit integer
+	   bit and sixteen bits of padding that binary128 has neither of, so the
+	   quad case cannot share the long-double one: its mantissa0 is sixteen
+	   bits wide and its shape has no `empty` member at all.  */
+#if defined(USE_QUAD_DOUBLE)
+	fp_declare_init_shape(sxp, extended);
+	sxp.ieee.exponent	= FP_EXTENDED_EXP_MAX;
+	sxp.ieee.mantissa0	= 0xffff;
+	sxp.ieee.mantissa1	= 0xffffffff;
+	sxp.ieee.mantissa2	= 0xffffffff;
+	sxp.ieee.mantissa3	= 0xffffffff;
+#elif defined(USE_LONG_DOUBLE)
 	fp_declare_init_shape(sxp, extended);
 	sxp.ieee.exponent	= FP_EXTENDED_EXP_MAX;
 	sxp.ieee.empty		= 0;
 	sxp.ieee.mantissa0	= 0xffffffff;
+	sxp.ieee.mantissa1	= 0xffffffff;
 #else
 	fp_declare_init_shape(sxp, double);
 	sxp.ieee.exponent	= FP_DOUBLE_EXP_MAX;
 	sxp.ieee.mantissa0	= 0xfffff;
-#endif
 	sxp.ieee.mantissa1	= 0xffffffff;
-#ifdef USE_QUAD_DOUBLE
-	sxp.ieee.mantissa2	= 0xffffffff;
-	sxp.ieee.mantissa3	= 0xffffffff;
 #endif
 	sxp.ieee.negative   = negative;
 	r = sxp.value;
@@ -581,22 +589,29 @@ PRIVATE inline void FFPU make_zero(fpu_register & r, bool negative)
 
 PRIVATE inline void FFPU make_inf(fpu_register & r, bool negative)
 {
-#if defined(USE_LONG_DOUBLE) || defined(USE_QUAD_DOUBLE)
+	/* The 0x80000000 in the long-double case is the x87's explicit integer
+	   bit, which infinity carries. binary128 has no such bit, and an infinity
+	   with any fraction bit set is a NaN — so the quad case sets none.  */
+#if defined(USE_QUAD_DOUBLE)
+	fp_declare_init_shape(sxp, extended);
+	sxp.ieee.exponent	= FP_EXTENDED_EXP_MAX;
+	sxp.ieee.mantissa0	= 0;
+	sxp.ieee.mantissa1	= 0;
+	sxp.ieee.mantissa2	= 0;
+	sxp.ieee.mantissa3	= 0;
+#elif defined(USE_LONG_DOUBLE)
 	fp_declare_init_shape(sxp, extended);
 	sxp.ieee.exponent	= FP_EXTENDED_EXP_MAX;
 	sxp.ieee.mantissa0	= 0x80000000;
 	sxp.ieee.empty		= 0;
+	sxp.ieee.mantissa1	= 0;
 #else
 	fp_declare_init_shape(sxp, double);
 	sxp.ieee.exponent	= FP_DOUBLE_EXP_MAX;
 	sxp.ieee.mantissa0	= 0;
-#endif
-	sxp.ieee.negative	= negative;
 	sxp.ieee.mantissa1	= 0;
-#ifdef USE_QUAD_DOUBLE
-	sxp.ieee.mantissa2 = 0;
-	sxp.ieee.mantissa3 = 0;
 #endif
+	sxp.ieee.negative	= negative;
 	r = sxp.value;
 }
 
