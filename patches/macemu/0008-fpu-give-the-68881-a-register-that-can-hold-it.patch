-#elif 0
-/* Disable for now and probably for good as (i) the emulator
-   implementation is not correct, (ii) I don't know of any CPU which
-   handles this kind of format *natively* with conformance to IEEE.  */
+#elif __LDBL_MANT_DIG__ == 113
+/* IEEE binary128, which AArch64 and a few others make `long double`. Both
+   objections in the comment this replaces have expired: (ii) said no CPU
+   handled the format natively with conformance to IEEE, and AArch64 does — in
+   software, through libgcc, but conformantly, and its libm carries real
+   long-double kernels rather than aliases to double; (i) said the emulator
+   implementation was not correct, and it was not — make_extended() was not the
+   inverse of extract_extended(), which is fixed in the same patch as this.
+
+   It is the only format on such a host that holds a 68881 register without
+   losing anything: the exponent field is 15 bits with bias 16383, exactly the
+   Macintosh's, and 112 fraction bits hold the 68881's 63 with room to spare.
+   The alternative, which upstream's configure picks on ARM, is MPFR — correct
+   too, and a malloc and a free per floating-point instruction.  */
 typedef long double uae_f128;
 typedef uae_f128 fpu_register;
 #define USE_QUAD_DOUBLE 1
