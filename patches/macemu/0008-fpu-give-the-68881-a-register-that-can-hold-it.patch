 #elif defined(USE_LONG_DOUBLE)
 	fp_declare_init_shape(srp, extended);
 	srp.ieee.negative	= (wrd1 >> 31) & 1;
@@ -2475,4 +2519,59 @@ PUBLIC void FFPU fpu_reset (void)
 	fpu_init(FPU is_integral);
 }
 
+#ifdef FPU_SELFTEST
+/*
+ *  Does a 68881 extended value survive a trip through an fpu_register?
+ *
+ *  It is the one property of this file that can be checked without a Macintosh,
+ *  and the one that used to fail: make_extended() and extract_extended() are
+ *  supposed to be inverses, and on a host whose fpu_register is narrower than
+ *  80 bits they cannot be. Saying so out loud beats discovering it inside a
+ *  spreadsheet.
+ *
+ *  Returns the number of patterns that did not come back unchanged, and leaves
+ *  the first one that did not in *first, so a caller can print it. A host that
+ *  keeps the register in a double is expected to fail most of these; that is
+ *  the measurement, not a bug in the test.
+ */
+extern "C" int fpu_selftest_extended(uae_u32 *first)
+{
+	static const uae_u32 patterns[][3] = {
+		/* one, and one with every fraction bit that a double would drop */
+		{ 0x3fff0000, 0x80000000, 0x00000000 },
+		{ 0x3fff0000, 0x80000000, 0x00000001 },
+		{ 0x3fff0000, 0x80000000, 0x000007ff },
+		{ 0x3fff0000, 0xffffffff, 0xffffffff },
+		{ 0xbfff0000, 0xffffffff, 0xffffffff },
+		/* pi to 64 bits, which is what FMOVECR #0 hands over */
+		{ 0x40000000, 0xc90fdaa2, 0x2168c235 },
+		/* the exponent range a double cannot reach, both ends */
+		{ 0x00010000, 0x80000000, 0x00000000 },
+		{ 0x7ffe0000, 0xffffffff, 0xffffffff },
+		{ 0x10000000, 0x80000000, 0x00000000 },
+		{ 0x6fff0000, 0x80000000, 0x00000000 },
+		/* smallest and largest normal a double *can* reach, for contrast */
+		{ 0x3c010000, 0x80000000, 0x00000000 },
+		{ 0x43fe0000, 0xffffffff, 0xf8000000 },
+	};
+
+	int failures = 0;
+	for (unsigned i = 0; i < sizeof patterns / sizeof patterns[0]; i++) {
+		uae_u32 w1 = 0, w2 = 0, w3 = 0;
+		fpu_register r = make_extended(patterns[i][0], patterns[i][1], patterns[i][2]);
+		extract_extended(r, &w1, &w2, &w3);
+
+		if (w1 == patterns[i][0] && w2 == patterns[i][1] && w3 == patterns[i][2])
+			continue;
+
+		if (failures == 0 && first != 0) {
+			first[0] = patterns[i][0]; first[1] = patterns[i][1]; first[2] = patterns[i][2];
+			first[3] = w1;             first[4] = w2;             first[5] = w3;
+		}
+		failures++;
+	}
+	return failures;
+}
+#endif
+
 #endif
