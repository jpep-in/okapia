configure: offer the softfloat FPU core

--enable-fpe=softfloat builds fpu_softfloat.cpp and the 68K softfloat
beside it. It needs a C compiler and 64-bit integers, nothing else; on
ARM it replaces MPFR and GMP, on any host it is the 68881's own format
rounded as the 68881 rounds.

The default is left as it was. On ARM and AArch64 it is worth making
this the default in place of MPFR, and the Xcode project would gain the
same choice; both are left to a later change.

diff --git a/BasiliskII/src/Unix/configure.ac b/BasiliskII/src/Unix/configure.ac
index d4572265..d7b836f7 100644
--- a/BasiliskII/src/Unix/configure.ac
+++ b/BasiliskII/src/Unix/configure.ac
@@ -52,7 +52,9 @@ AC_ARG_ENABLE(fpe,
     ieee)	FPE_CORE_TEST_ORDER="ieee";;
     uae)	FPE_CORE_TEST_ORDER="uae";;
     x86)	FPE_CORE_TEST_ORDER="x86";;
-	*)		AC_MSG_ERROR([--enable-fpe takes only one of the following values: auto, x86, ieee, uae]);;
+    dnl the 68881 in its own 80-bit format, the same bits on every host
+    softfloat)	FPE_CORE_TEST_ORDER="softfloat";;
+	*)		AC_MSG_ERROR([--enable-fpe takes only one of the following values: auto, x86, ieee, uae, softfloat]);;
   esac
 ],
 [ FPE_CORE_TEST_ORDER="ieee uae"
@@ -1915,6 +1917,13 @@ for fpe in $FPE_CORE_TEST_ORDER; do
     FPUSRCS="$UAE_PATH/fpu/fpu_uae.cpp"
     break
     ;;
+  softfloat)
+    dnl 64-bit integer arithmetic only: no long double, no library
+    FPE_CORE="68881 softfloat core"
+    DEFINES="$DEFINES -DFPU_SOFTFLOAT"
+    FPUSRCS="$UAE_PATH/fpu/fpu_softfloat.cpp $UAE_PATH/fpu/softfloat/softfloat.c $UAE_PATH/fpu/softfloat/softfloat_fpsp.c $UAE_PATH/fpu/softfloat/softfloat_decimal.c"
+    break
+    ;;
   *)
     AC_MSG_ERROR([Internal configure.in script error for $fpe fpu core])
     ;;
