---
// Copyright (C) 2026 Jonathan Pepin
// SPDX-License-Identifier: GPL-3.0-or-later
import '../styles/site.css';
import { link, repository } from '../lib/links';
import { targetFromPath } from '../lib/navigation.mjs';
const { title = 'Run System 7 through Mac OS 9.', description = 'A classic Macintosh, on your Mac or on Raspberry Pi 4. Meet Okapia: one application, two generations of Macintosh.', home = false } = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
const target = targetFromPath(current, import.meta.env.BASE_URL) || 'mac';
const hasTargetPicker = home || current.includes('/start/');
---
<!doctype html>
<html lang="en" data-has-picker={hasTargetPicker ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8faf8" />
    <title>{home ? 'Okapia — ' + title : title + ' — Okapia'}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('assets/okapia.svg')} />
    <link rel="preload" href={link('assets/heros-regular.otf')} as="font" type="font/otf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={'Okapia — ' + title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(link('assets/social.svg'), Astro.site).href} />
    <meta property="og:url" content={canonical} />
  </head>
  <body data-target={target}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-header-shell"><header class="site-header wrap">
      <a class="brand" href={link()} aria-label="Okapia home"><img src={link('assets/okapia.svg')} width="33" height="40" alt="" />Okapia</a>
      <nav aria-label="Main navigation">
        <a href={link()} aria-current={home ? 'page' : undefined}>Discover</a>
        <a href={link('start/' + target + '/')} data-start-link aria-current={current.includes('/start/') || current.includes('/downloads/') ? 'page' : undefined}>Get started</a>
        <a href={link('help/')} aria-current={current.includes('/help/') ? 'page' : undefined}>Help</a>
        <a href={link('advanced/')} aria-current={current.includes('/advanced/') ? 'page' : undefined}>Advanced</a>
        <a href={link('about/')} aria-current={current.includes('/about/') ? 'page' : undefined}>About</a>
      </nav>
    </header></div>
    {hasTargetPicker && <div class="page-context"><div class="wrap page-context-inner"><div class="host-picker" role="group" aria-label="Choose your Macintosh setup">
        <button type="button" data-site-target="mac" aria-pressed={target === 'mac' ? 'true' : 'false'} aria-label="Use Okapia on Mac"><svg viewBox="0 0 28 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="18" height="14" rx="2"/><path d="M5 17 2 21h24l-3-4M11 19h6"/></svg><span>Mac</span></button>
        <button type="button" data-site-target="pi" aria-pressed={target === 'pi' ? 'true' : 'false'} aria-label="Use Okapia on Raspberry Pi 4"><svg viewBox="0 0 32 26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter"><path d="M26 8V5a3 3 0 0 0-3-3H5a3 3 0 0 0-3 3v16a3 3 0 0 0 3 3h18q1.3 0 2.2-1M26 14v3" stroke-linejoin="round"/><path d="M23 8h7v6h-7zM23 17h7v6h-7zM11 11h7v7h-7zM9 22h6v3H9z"/><path d="M8 6h12" stroke-width="3" stroke-dasharray="1.6 1.8"/><circle cx="5.5" cy="6" r="1.2" fill="currentColor" stroke="none"/><circle cx="5.5" cy="20" r="1.2" fill="currentColor" stroke="none"/></svg><span>Pi 4</span></button>
      </div></div></div>}
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="brand" href={link()}><img src={link('assets/okapia.svg')} width="27" height="33" alt="" />Okapia</a><p>A classic Macintosh, at home again.</p></div>
      <div class="footer-links"><a href={link('downloads/')}>Downloads</a><a href={link('help/')}>Help</a><a href={link('advanced/')}>Advanced</a><a href={link('about/')}>About</a><a href={link('changelog/')}>Changelog</a><a href={repository}>Source</a><a href={repository + '/blob/main/LICENSE'}>GPLv3 or later</a></div>
      <p class="legal">Made by Jonathan Pepin. Built on Basilisk II, SheepShaver and Circle.<br />An independent project, not affiliated with Apple. Macintosh and Mac OS are trademarks of Apple Inc.</p>
    </footer>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
