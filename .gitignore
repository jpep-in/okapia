# Apple ROMs and disk images are never committed
roms/
*.rom
*.img
*.image
*.dsk
*.hfv
# Local SD contents: disk images, ROMs and kernel images staged for QEMU
qemu/sd-contents/

# Reference clones, fetched by script
reference/

# Generated by scripts/install-tools.sh
scripts/env.sh

# Build output
build/
*.o
*.d
*.a
*.elf
*.map
kernel*.img

.DS_Store

# Link probe intermediates
tests/*/obj/
tests/link-probe/undefined.txt

# Firmware specimen build output
src/firmware/circle/obj/
src/firmware/circle/kernel8.*
tests/host/render_specimen
tests/host/check_geometry
tests/host/check_screen
tests/host/check_chooser
tests/host/check_pages
tests/host/check_platform
tests/host/make_large_volume
tests/host/check_platform.tmp
tests/host/check_blit
tests/host/check_encoding
tests/host/render_chooser
tests/host/render_pages
tests/host/*.ppm

# Kernel build intermediates
src/kernel/emu-*/
src/kernel/*.o
src/kernel/*.d
src/kernel/kernel8.*
src/kernel/.engine
qemu/serial.log
src/kernel/kernel8.lst
.idea/

# Working material, not the project: design references gathered by hand and
# notes taken while reading upstream. They belong to whoever wrote them.
boot-menu/
research_notes/

# Disk images the Mac boots from: same rule as *.img, different extension.
*.hda

# Boot files staged for a real Pi 4 card by scripts/make-pi-sd.sh
rpi4-sd-contents/
