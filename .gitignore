# Apple ROMs and disk images are never committed
roms/
*.rom
*.img
*.image
*.dsk
*.hfv
# Local SD contents: disk images and ROMs staged for QEMU
qemu/sd-contents/

# Reference clones, fetched by script
reference/

# Generated by scripts/install-tools.sh
scripts/env.sh

# Build output
build/
*.o
*.d
*.a
*.elf
*.map
kernel*.img

.DS_Store

# Link probe intermediates
tests/*/obj/
tests/link-probe/undefined.txt

# Firmware specimen build output
src/firmware/circle/obj/
src/firmware/circle/kernel8.*
tests/host/render_specimen
tests/host/check_geometry
tests/host/check_screen
tests/host/*.ppm

# Kernel build intermediates
src/kernel/emu/
src/kernel/*.o
src/kernel/*.d
src/kernel/kernel8.*
qemu/serial.log
src/kernel/kernel8.lst
.idea/
